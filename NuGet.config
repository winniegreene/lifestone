<?xml version="1.0" encoding="utf-8"?>
<!--
  Pin package restore for this repo to nuget.org only, independent of whatever sources are
  configured machine- or user-wide. Every package in the graph is reviewed (see TECHNICAL.md).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
