<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine-agnostic client logic that sits between the data layer and the presentation layer: AC coordinates and map
    coordinates, the floating origin, landblock streaming plans, main-thread/worker scheduling and (M2) the session
    layer. No Godot references (Lifestone.Game is the only project that may use Godot). It may use Lifestone.Net's
    records and interfaces, but opens no sockets and does no file I/O: hosts supply bytes and Streams.
    TargetFramework / Nullable / LangVersion come from ../../Directory.Build.props.
  -->
  <PropertyGroup>
    <RootNamespace>Lifestone.Client</RootNamespace>
    <AssemblyName>Lifestone.Client</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lifestone.Data\Lifestone.Data.csproj" />
    <ProjectReference Include="..\Lifestone.Net\Lifestone.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The server mod's wire contract (the '@lifestone' requests and replies; BCL only), compiled into this assembly so the
      client and the mod share one copy. The mod itself stays outside Lifestone.slnx and the Directory.Build.props gate;
      Lifestone.ServerMod.Tests tests these files through this assembly. Matches nothing until the server-mod track adds
      server/mod/Shared.
    -->
    <Compile Include="..\..\server\mod\Shared\**\*.cs" Link="ServerTools\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- M5 item 2 (D22, D43): the hunting-ground profiles, one JSON file per ground, read once by Session/Grounds/GroundCatalog.cs. -->
    <EmbeddedResource Include="Session\Grounds\profiles\*.json" LogicalName="Lifestone.Client.Session.Grounds.profiles.%(Filename)%(Extension)" />
    <!-- M6 item 0 a1 (DoD 1): the ladders, one JSON file per ladder, read by Session/Grounds/LadderLoader.cs. -->
    <EmbeddedResource Include="Session\Grounds\ladder\*.json" LogicalName="Lifestone.Client.Session.Grounds.ladder.%(Filename)%(Extension)" />
    <!-- M6 item 1 c (D28, D40): the scrivener catalog, read by Session/Grounds/ScrivenerCatalog.cs. -->
    <EmbeddedResource Include="Session\Grounds\scriveners.json" LogicalName="Lifestone.Client.Session.Grounds.scriveners.json" />
    <!-- M6 14 (the every-spell rule): every scroll the catalog's scriveners sell, read by Session/Grounds/ScrivenerStock.cs. -->
    <EmbeddedResource Include="Session\Grounds\scrivener-stock.json" LogicalName="Lifestone.Client.Session.Grounds.scrivener-stock.json" />
    <EmbeddedResource Include="Session\Grounds\creatures.json" LogicalName="Lifestone.Client.Session.Grounds.creatures.json" />
    <!-- M6 14 the element line: every creature weenie's seven damage resistances, read by Session/Grounds/CreatureResists.cs. -->
    <EmbeddedResource Include="Session\Grounds\creature-resists.json" LogicalName="Lifestone.Client.Session.Grounds.creature-resists.json" />
    <!-- M6 14 the derived incoming: every creature weenie's magic and attack skills and its weapons' WeaponSkill, read by Session/Grounds/CreatureSkills.cs. -->
    <EmbeddedResource Include="Session\Grounds\creature-skills.json" LogicalName="Lifestone.Client.Session.Grounds.creature-skills.json" />
    <!-- M6 16 E1d: every creature weenie's behaviour facts (senses, temper, stamina and mana, rates, Run, experience, body), read by Session/Grounds/CreatureBehaviour.cs. -->
    <EmbeddedResource Include="Session\Grounds\creature-behaviour.json" LogicalName="Lifestone.Client.Session.Grounds.creature-behaviour.json" />
    <!-- M6 item 4 D50: the travel routes (portal edges, routes per ground, ways home), read by Session/Travel/TravelRoutes.cs. -->
    <EmbeddedResource Include="Session\Travel\travel-routes.json" LogicalName="Lifestone.Client.Session.Travel.travel-routes.json" />
    <!-- M6 14 (m6-14-plaza): every placed portal of the world (the pinned world SQL), read by Session/Travel/WorldPortals.cs: the portals every walk keeps off, and the portal a teleport came from. -->
    <EmbeddedResource Include="Session\Travel\world-portals.json" LogicalName="Lifestone.Client.Session.Travel.world-portals.json" />
    <!-- M6 item 4 t4a (D26): the doors that open only by a linked lever, read by Session/Scenarios/Journey/TownNetworkTrip.cs. -->
    <EmbeddedResource Include="Session\Scenarios\Journey\lever-doors.json" LogicalName="Lifestone.Client.Session.Scenarios.Journey.lever-doors.json" />
    <!-- M6 item 0 a2 (DoD 7, D26): the quest files, one JSON file per quest, read once by Session/Quests/QuestCatalog.cs. -->
    <EmbeddedResource Include="Session\Quests\quests\*.json" LogicalName="Lifestone.Client.Session.Quests.quests.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lifestone.Client.Tests" />
    <InternalsVisibleTo Include="Lifestone.WorldWalk" />
    <InternalsVisibleTo Include="Lifestone.Loopback.Tests" />
    <InternalsVisibleTo Include="Lifestone.ServerMod.Tests" />
  </ItemGroup>

</Project>
