<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Lifestone.Net.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same packages and versions as Lifestone.Data.Tests (the .NET SDK 10.0.401 'xunit' template); nothing new. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lifestone.Net\Lifestone.Net.csproj" />
    <!--
      Test-only: the Data-level tests/Shared helpers (the dats gates) compile against Lifestone.Data, and the motion
      command table the net track pins lives in Data/Animation. Lifestone.Net itself stays BCL only.
    -->
    <ProjectReference Include="..\..\src\Lifestone.Data\Lifestone.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/Shared, Data-level part (tests/Shared/README.md); this project does not reference Lifestone.Client. -->
    <Compile Include="..\Shared\**\*.cs" Exclude="..\Shared\Client\**;..\Shared\Loopback\**" LinkBase="Shared" />
  </ItemGroup>

</Project>
