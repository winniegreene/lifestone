<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Lifestone.Client.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same packages and versions as Lifestone.Data.Tests (the .NET SDK 10.0.401 'xunit' template); nothing new. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lifestone.Client\Lifestone.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      tests/Shared (tests/Shared/README.md): one copy of the helpers the test projects share - the dats gates and
      DatSetFixture, RepositoryFiles, AllocationMeasurement, ManualTimeProvider, and the Client-level ones - linked, not
      duplicated. Shared/Loopback/** belongs to Lifestone.Loopback.Tests alone.
    -->
    <Compile Include="..\Shared\**\*.cs" Exclude="..\Shared\Client\**;..\Shared\Loopback\**" LinkBase="Shared" />
    <Compile Include="..\Shared\Client\**\*.cs" LinkBase="Shared\Client" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The bestiary's generator (tools/fight-sim, docs/fight-sim.md; M6 item 16 E1c): its column lists, picks, writer and
      check are plain C# with no ACE type, compiled here too, so BestiaryGeneratorTests proves them with no database, no
      dats and no ACE build. The tool's own project stays outside Lifestone.slnx (it needs the ACE build), and
      BestiaryWorld.cs, its reads through ACE's models, is not compiled here.
    -->
    <Compile Include="..\..\tools\fight-sim\BestiaryModel.cs;..\..\tools\fight-sim\BestiaryTables.cs;..\..\tools\fight-sim\BestiaryRows.cs;..\..\tools\fight-sim\BestiaryWriter.cs;..\..\tools\fight-sim\BestiaryCheck.cs" LinkBase="Tools\FightSim" />
    <!--
      The simulator's in-fight policy (docs/fight-sim.md, "With her heals"): the decision is plain C# with no ACE type that calls the
      client's own rules (FightEmergency, HealPick, VitalsPolicy, TargetSwitch), compiled here too so InFightRulesTests proves it.
      InFight.cs, which plays each cast through ACE, is not compiled here.
    -->
    <Compile Include="..\..\tools\fight-sim\InFightRules.cs" LinkBase="Tools\FightSim" />
  </ItemGroup>

</Project>
