<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Lifestone.Client.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same packages and versions as Lifestone.Data.Tests (the .NET SDK 10.0.401 'xunit' template); nothing new. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lifestone.Client\Lifestone.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One shared copy of the dats-gated attributes (and DatSetFixture): linked from the data tests, not duplicated. -->
    <Compile Include="..\Lifestone.Data.Tests\RequiresDatsFactAttribute.cs" Link="Shared\RequiresDatsFactAttribute.cs" />
    <Compile Include="..\Lifestone.Data.Tests\RequiresDatsTheoryAttribute.cs" Link="Shared\RequiresDatsTheoryAttribute.cs" />
  </ItemGroup>

</Project>
