<!-- Lifestone ACE log4net configuration (template). Rendered to server/runtime/ace/log4net.config by setup-server.ps1.
     Placeholder: {{LOGDIR}} (absolute, backslashes). -->
<log4net>

  <appender name="Console" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level: %message%newline" />
    </layout>
    <threshold value="INFO" />
  </appender>

  <!-- Everything (including DEBUG) -->
  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="{{LOGDIR}}\ACE_Log.txt" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="10" />
    <maximumFileSize value="20480KB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level (%logger) %message%newline" />
    </layout>
    <threshold value="ALL" />
  </appender>

  <!-- Warnings and errors only -->
  <appender name="RollingFileAppender-WARN" type="log4net.Appender.RollingFileAppender">
    <file value="{{LOGDIR}}\ACE_Log-WARN.txt" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="5" />
    <maximumFileSize value="20480KB" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level (%logger) %message%newline" />
    </layout>
    <threshold value="WARN" />
  </appender>

  <logger name="Packets">
    <level value="INFO" />
  </logger>

  <appender name="asyncForwarder" type="Log4Net.Async.AsyncForwardingAppender,Log4Net.Async">
    <appender-ref ref="Console" />
    <appender-ref ref="RollingFileAppender" />
    <appender-ref ref="RollingFileAppender-WARN" />
  </appender>

  <root>
    <level value="ALL" />
    <appender-ref ref="asyncForwarder" />
  </root>

</log4net>
